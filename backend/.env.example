# Copy to .env and replace all placeholders before running outside tests.
DATABASE_URL=sqlite:///./jsbh_dev.db
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=jsbh_session
CSRF_COOKIE_NAME=jsbh_csrf
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=30
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST_KIB=19456
ARGON2_PARALLELISM=1

# Required only by scripts/create_owner.py. Never commit real values.
SEED_OWNER_USERNAME=
SEED_OWNER_PASSWORD=
SEED_OWNER_EMAIL=
