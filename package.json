{
  "name": "js-baking-house",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test",
    "audit:npm": "npm audit --audit-level=high",
    "test:backend": "backend/.venv/bin/python -m pytest backend/tests",
    "audit:pip": "backend/.venv/bin/pip-audit -r backend/requirements.txt --no-deps",
    "scan:bandit": "backend/.venv/bin/bandit -q -r backend/app backend/scripts",
    "verify": "npm run test && npm run lint && npm run build && npm run audit:npm",
    "verify:backend": "npm run test:backend && npm run audit:pip && npm run scan:bandit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
