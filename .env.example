# Copy to .env before running `docker compose up --build`.
# Use long random values; keep this file out of version control.
# Choose URL-safe credentials (letters/digits) for PostgreSQL and Redis so the
# connection URLs built in docker-compose.yml need no percent-encoding.

POSTGRES_DB=jsbh
POSTGRES_USER=jsbh
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# Separate database identities. The API never uses the bootstrap superuser.
# Each password must be at least 20 characters. Use URL-safe letters/digits.
JSBH_OWNER_USER=jsbh_owner
JSBH_OWNER_PASSWORD=replace-with-a-long-random-migration-password
JSBH_APP_USER=jsbh_app
JSBH_APP_PASSWORD=replace-with-a-long-random-runtime-password

WEB_PORT=8080
ENVIRONMENT=production

# TLS overlay (docker-compose.tls.yml). Set these to enable HTTPS termination,
# the HTTP to HTTPS redirect and HSTS. certbot can issue certificates into
# ${TLS_CERT_DIR}/live/${TLS_DOMAIN}/ using the shared ACME webroot.
TLS_DOMAIN=bakery.example.com
TLS_EMAIL=ops@example.com
TLS_CERT_DIR=./deploy/certs
AUTO_CREATE_SCHEMA=false

# Must match the public origin users visit (comma-separated if more than one).
CORS_ORIGINS=https://bakery.example.com
FRONTEND_URL=https://bakery.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Required in production for owner password recovery and email verification.
# Leave empty only for an isolated demo deployment without those flows.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Required in production to encrypt authenticator secrets at rest.
# Generate with: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=

JSBH_API_WORKERS=2

# Encrypted backups (AES-256) of the database volume. The backup service
# refuses to start unless off-site sync is configured or local-only storage is
# explicitly accepted. Use a long random passphrase and store it separately.
# Security alerts for failed-login bursts, role/status changes, recovery-code
# issuance and audit-chain failures. Configure at least one destination.
ALERT_EMAIL_TO=security@example.com
# HTTPS is enforced for webhooks in production.
ALERT_WEBHOOK_URL=https://hooks.example.com/js-baking-alerts
ALERT_FAILED_LOGIN_THRESHOLD=5
ALERT_WINDOW_MINUTES=15
ALERT_COOLDOWN_MINUTES=30
AUDIT_CHECK_INTERVAL_MINUTES=360

# Argon2id parameters. Defaults follow the OWASP baseline; re-run
# backend/scripts/benchmark_argon2.py on the target host before tuning.
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST_KIB=19456
ARGON2_PARALLELISM=1

BACKUP_PASSPHRASE=replace-with-a-long-random-backup-passphrase
BACKUP_CRON=0 2 * * *
BACKUP_ON_START=true
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Example: RCLONE_REMOTE=jsbh-backups:/jsbh
RCLONE_REMOTE=
ALLOW_LOCAL_ONLY_BACKUPS=false

# Bootstrap the first real owner once, from environment-only credentials.
# Do not commit the password anywhere; clear these after the first start.
SEED_OWNER_USERNAME=
SEED_OWNER_PASSWORD=
SEED_OWNER_EMAIL=

# Never enable in a real deployment. See docker-compose.demo.yml instead.
JSBH_ALLOW_DEMO_SEED=false
