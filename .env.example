# Copy to .env before running `docker compose up --build`.
# Use long random values; keep this file out of version control.
# Choose URL-safe credentials (letters/digits) for PostgreSQL and Redis so the
# connection URLs built in docker-compose.yml need no percent-encoding.

POSTGRES_DB=jsbh
POSTGRES_USER=jsbh
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# Separate database identities. The API never uses the bootstrap superuser.
# Each password must be at least 20 characters. Use URL-safe letters/digits.
JSBH_OWNER_USER=jsbh_owner
JSBH_OWNER_PASSWORD=replace-with-a-long-random-migration-password
JSBH_APP_USER=jsbh_app
JSBH_APP_PASSWORD=replace-with-a-long-random-runtime-password

WEB_PORT=8080
ENVIRONMENT=production
AUTO_CREATE_SCHEMA=false

# Must match the public origin users visit (comma-separated if more than one).
CORS_ORIGINS=https://bakery.example.com
FRONTEND_URL=https://bakery.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Required in production for owner password recovery and email verification.
# Leave empty only for an isolated demo deployment without those flows.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Required in production to encrypt authenticator secrets at rest.
# Generate with: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=

JSBH_API_WORKERS=2

# Bootstrap the first real owner once, from environment-only credentials.
# Do not commit the password anywhere; clear these after the first start.
SEED_OWNER_USERNAME=
SEED_OWNER_PASSWORD=
SEED_OWNER_EMAIL=

# Never enable in a real deployment. See docker-compose.demo.yml instead.
JSBH_ALLOW_DEMO_SEED=false
